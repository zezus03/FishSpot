rules_version = '2';

// Pravila za FishSpot bazu. Cloud Functions i Gemini ekstenzija koriste admin pristup
// i ne prolaze kroz ova pravila. Sve sto nije navedeno ispod je zabranjeno.
service cloud.firestore {
  match /databases/{database}/documents {

    function prijavljen() {
      return request.auth != null;
    }

    function jaSam(uid) {
      return prijavljen() && request.auth.uid == uid;
    }

    // Tekstualno polje (ako postoji) nije duže od max znakova
    function tekstDo(polje, max) {
      return !(polje in request.resource.data)
        || (request.resource.data[polje] is string && request.resource.data[polje].size() <= max);
    }

    // Menjaju se samo navedena polja
    function menjaSamo(polja) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(polja);
    }

    // ─── KORISNICI ───
    // Svi prijavljeni vide profile (rang lista, imena kod komentara),
    // a svako menja samo svoj dokument. Poeni mogu samo da rastu, najvise 50 odjednom
    // (najveca nagrada za jedan ulov).
    match /Korisnici/{uid} {
      allow read: if prijavljen();
      allow create: if jaSam(uid) && request.resource.data.get('poeni', 0) == 0 && profilIspravan();
      allow update: if jaSam(uid) && poeniIspravni() && profilIspravan();

      function profilIspravan() {
        return tekstDo('userName', 60) && tekstDo('imePrezime', 100) && tekstDo('telefon', 30);
      }
      allow delete: if false;

      function poeniIspravni() {
        let stari = resource.data.get('poeni', 0);
        let novi = request.resource.data.get('poeni', 0);
        return novi == stari || (novi > stari && novi - stari <= 50);
      }
    }

    // ─── ULOVI / MESTA ZA PECANJE ───
    match /MestaZaPecanje/{spotId} {
      allow read: if prijavljen();
      allow create: if prijavljen() && request.resource.data.authorId == request.auth.uid && ulovIspravan();
      // Autor menja svoj ulov (npr. UploadWorker dodaje slikaUrl), ali ne sme da promeni autora.
      // Ostali smeju samo da dodaju ili uklone svoj lajk.
      allow update: if prijavljen() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && ulovIspravan())
        || (menjaSamo(['likedBy']) && menjaSamoSvojLajk())
      );
      allow delete: if prijavljen() && resource.data.authorId == request.auth.uid;

      // Dužina i težina moraju imati smisla za vrstu (iste granice kao OgranicenjaRibe.kt u aplikaciji)
      function ulovUGranicama() {
        let granice = {'saran': [120, 45], 'babuska': [50, 3], 'karas': [55, 3.5], 'amur': [150, 50], 'beli-tolstolobik': [125, 55], 'sivi-tolstolobik': [160, 60], 'linjak': [70, 7.5], 'deverika': [85, 9], 'krupatica': [45, 1.5], 'crnooka': [50, 2], 'nosara': [55, 3], 'bodorka': [55, 2.5], 'plotica': [60, 3.5], 'crvenperka': [50, 2.2], 'klen': [80, 8], 'jaz': [100, 8], 'bucov': [120, 13], 'skobalj': [55, 2.5], 'mrena': [120, 13], 'potocna-mrena': [35, 0.7], 'ukljeva': [25, 0.25], 'sabljarka': [65, 2.2], 'krkusa': [22, 0.25], 'gavcica': [12, 0.05], 'grgec': [60, 5], 'smud': [130, 20], 'smud-kamenjar': [55, 2.5], 'balavac': [25, 0.4], 'stuka': [150, 30], 'som': [280, 140], 'patuljasti-som': [55, 3], 'crni-patuljasti-som': [65, 4], 'manic': [100, 15], 'jegulja': [150, 9], 'keciga': [125, 16], 'potocna-pastrmka': [100, 20], 'kalifornijska-pastrmka': [100, 25], 'mladica': [160, 60], 'lipljen': [60, 3.5], 'potocna-zlatovcica': [70, 7], 'suncanica': [30, 0.7], 'glavoc': [30, 0.5], 'ostalo': [300, 150]};
        let d = request.resource.data;
        let g = granice.get(d.get('vrstaId', 'ostalo'), [300, 150]);
        return d.get('duzinaRibe', 0) is number && d.get('tezinaRibe', 0) is number
          && d.get('duzinaRibe', 0) >= 0 && d.get('duzinaRibe', 0) <= g[0]
          && d.get('tezinaRibe', 0) >= 0 && d.get('tezinaRibe', 0) <= g[1];
      }

      // Varalica ide samo uz tehniku varalica, mušica samo uz mušičarenje
      function mamacITehnikaSlazu() {
        let d = request.resource.data;
        return (d.get('mamac', '') == 'Varalica') == (d.get('tehnika', '') == 'Varalica')
          && (d.get('mamac', '') == 'Mušica') == (d.get('tehnika', '') == 'Mušičarenje');
      }

      function ulovIspravan() {
        return tekstDo('naziv', 100) && tekstDo('opis', 1000)
          && tekstDo('mamac', 40) && tekstDo('tehnika', 40)
          && ulovUGranicama() && mamacITehnikaSlazu();
      }

      function menjaSamoSvojLajk() {
        let stari = resource.data.get('likedBy', []).toSet();
        let novi = request.resource.data.likedBy.toSet();
        return novi.difference(stari).hasOnly([request.auth.uid])
          && stari.difference(novi).hasOnly([request.auth.uid]);
      }

      match /komentari/{commentId} {
        allow read: if prijavljen();
        allow create: if prijavljen() && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if prijavljen() && resource.data.authorId == request.auth.uid;
      }
    }

    // ─── VRSTE RIBA ───
    // Lista vrsta je samo za citanje (upisuje se iz functions/podaci/vrsteRiba.json).
    // Pod svakom vrstom je spisak ulova te vrste; ID ulova je isti kao u MestaZaPecanje.
    match /VrsteRiba/{vrstaId} {
      allow read: if prijavljen();
      allow write: if false;

      match /Ulovi/{ulovId} {
        allow read: if prijavljen();
        allow create: if prijavljen() && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if prijavljen() && resource.data.authorId == request.auth.uid;
      }
    }

    // ─── PRIJAVE ULOVA ───
    // ID prijave je "{idUlova}_{uid}", pa svako moze da prijavi isti ulov samo jednom.
    // Korisnik vidi samo svoje prijave (da zna da je vec prijavio); sve prijave se pregledaju u konzoli.
    match /Prijave/{prijavaId} {
      allow read: if prijavljen() && prijavaId.matches('.*_' + request.auth.uid);
      allow create: if prijavljen()
        && request.resource.data.prijavioId == request.auth.uid
        && prijavaId == request.resource.data.spotId + '_' + request.auth.uid
        && request.resource.data.razlog is string
        && request.resource.data.razlog.size() <= 100
        && request.resource.data.get('opis', '').size() <= 500
        // Svoj ulov ne moze da se prijavi
        && get(/databases/$(database)/documents/MestaZaPecanje/$(request.resource.data.spotId)).data.authorId != request.auth.uid;
      allow update, delete: if false;
    }

    // ─── PRIJAVLJENI ULOVI (pregled za admina) ───
    // Puni ih Cloud Function obradiPrijavuUlova; admin ih gleda u Firebase konzoli.
    match /PrijavljeniUlovi/{spotId} {
      allow read, write: if false;
    }

    // ─── VODOSTAJI (RHMZ) ───
    // Upisuje ih Cloud Function osveziVodostaje; aplikacija ih samo cita.
    // VodostajiDetalji su kes funkcije detaljiStanice i aplikacija ih ne cita direktno.
    match /Vodostaji/{dokument} {
      allow read: if prijavljen();
      allow write: if false;
    }
    match /VodostajiDetalji/{hmId} {
      allow read, write: if false;
    }

    // ─── VODE VAN SRBIJE ───
    // Kes i dnevne granice funkcije vodeUBlizini; aplikacija ih ne cita direktno
    match /VodeKes/{kljuc} {
      allow read, write: if false;
    }
    match /VodeLimit/{uid} {
      allow read, write: if false;
    }

    // ─── AKTIVNI KORISNICI (lokacija uzivo) ───
    match /ActiveUsers/{uid} {
      allow read: if prijavljen();
      allow write: if jaSam(uid);
    }

    // ─── PRIVATNE PORUKE ───
    // ID sobe je "uid1_uid2", pa poruke citaju i salju samo ta dva korisnika
    match /PrivateChats/{roomId}/Messages/{messageId} {
      allow read: if prijavljen() && request.auth.uid in roomId.split('_');
      allow create: if prijavljen()
        && request.auth.uid in roomId.split('_')
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        // Primalac je drugi učesnik razgovora (starije verzije aplikacije ga ne šalju)
        && (!('primalacId' in request.resource.data)
            || (request.resource.data.primalacId in roomId.split('_')
                && request.resource.data.primalacId != request.auth.uid));
      allow update, delete: if false;
    }

    // Dolazne poruke: primalac sluša sve svoje poruke odjednom (upit nad svim razgovorima)
    match /{put=**}/Messages/{porukaId} {
      allow read: if prijavljen() && resource.data.get('primalacId', '') == request.auth.uid;
    }

    // ─── CHAT BOT (Deda Pera) ───
    // Korisnik vidi samo svoj razgovor i salje samo pitanja; odgovor upisuje Gemini ekstenzija
    // Svako pitanje mora da ide zajedno sa uvećanjem brojača BotLimit/{uid} (isti upis),
    // a brojač dozvoljava najviše 30 pitanja u 24 sata, jer se svaki odgovor plaća.
    match /bot_chats/{uid}/messages/{messageId} {
      allow read: if jaSam(uid);
      allow create: if jaSam(uid)
        && request.resource.data.keys().hasOnly(['prompt', 'timestamp'])
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.prompt.size() <= 500
        // Vreme pitanja mora biti tačno (aplikacija prikazuje samo proverene odgovore novih pitanja)
        && request.resource.data.timestamp is int
        && request.resource.data.timestamp > request.time.toMillis() - 600000
        && request.resource.data.timestamp < request.time.toMillis() + 600000
        && getAfter(/databases/$(database)/documents/BotLimit/$(uid)).data.poslednja == messageId;
      allow update, delete: if false;
    }

    match /BotLimit/{uid} {
      allow read: if jaSam(uid);
      allow create, update: if jaSam(uid)
        && request.resource.data.keys().hasOnly(['broj', 'pocetak', 'poslednja'])
        && request.resource.data.poslednja is string
        && !exists(/databases/$(database)/documents/bot_chats/$(uid)/messages/$(request.resource.data.poslednja))
        && existsAfter(/databases/$(database)/documents/bot_chats/$(uid)/messages/$(request.resource.data.poslednja))
        && (novoRazdoblje() || isteRazdoblje());
      allow delete: if false;

      function novoRazdoblje() {
        return (resource == null || request.time > resource.data.pocetak + duration.value(1, 'd'))
          && request.resource.data.broj == 1
          && request.resource.data.pocetak == request.time;
      }

      function isteRazdoblje() {
        return resource != null
          && request.time <= resource.data.pocetak + duration.value(1, 'd')
          && request.resource.data.pocetak == resource.data.pocetak
          && request.resource.data.broj == resource.data.broj + 1
          && request.resource.data.broj <= 30;
      }
    }
  }
}
