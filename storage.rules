rules_version = '2';

// Pravila za FishSpot slike. Ekstenzija za smanjivanje slika (_200x200) koristi admin
// pristup i ne prolazi kroz ova pravila. Sve sto nije navedeno ispod je zabranjeno.
service firebase.storage {
  match /b/{bucket}/o {

    // Profilne slike: svi prijavljeni ih vide, a svako menja samo svoju (uid.jpg)
    match /profilne_slike/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Slike ulova: ime fajla je nasumicno (UUID), pa ogranicavamo velicinu i tip (samo slike) i zabranjujemo menjanje.
    // Aplikacija salje smanjene slike (oko 300 KB), pa je 5 MB dovoljna granica
    match /spot_slike/{fileName} {
      allow read: if request.auth != null;
      // Slike ulova šalje samo nalog sa potvrđenom e-adresom (kao i sam ulov u firestore.rules)
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
